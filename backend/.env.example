# Server
PORT=4000
NODE_ENV=development

# CORS — the frontend dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# LLM providers — Phase C (LLM Provider Integration).
# Groq is primary, Mistral is the fallback. Leave blank locally if you
# don't have keys yet; each provider fails safely and llmService will
# fall back / return a controlled error instead of crashing.
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional model overrides — sensible defaults are used if left blank.
GROQ_MODEL=llama-3.1-8b-instant
MISTRAL_MODEL=mistral-small-latest
